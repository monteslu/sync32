+/* sync32 two-level dispatch (see fceu.h) */
+#define FCEU_DISP_POOL 12
+readfunc fceu_aread_uni[256];
+readfunc *fceu_aread_sub[256];
+writefunc fceu_bwrite_uni[256];
+writefunc *fceu_bwrite_sub[256];
+static readfunc fceu_aread_pool[FCEU_DISP_POOL][256];
+static writefunc fceu_bwrite_pool[FCEU_DISP_POOL][256];
+static int fceu_aread_pool_n, fceu_bwrite_pool_n;
+
+static readfunc *aread_page_materialize(uint32_t pg) {
+	int i;
+	readfunc *t;
+	if (fceu_aread_sub[pg]) return fceu_aread_sub[pg];
+	if (fceu_aread_pool_n >= FCEU_DISP_POOL) {
+		FCEU_PrintError("dispatch pool exhausted (read)"); /* NEVER silent */
+		return NULL;
+	}
+	t = fceu_aread_pool[fceu_aread_pool_n++];
+	for (i = 0; i < 256; i++) t[i] = fceu_aread_uni[pg];
+	fceu_aread_sub[pg] = t;
+	return t;
+}
+static writefunc *bwrite_page_materialize(uint32_t pg) {
+	int i;
+	writefunc *t;
+	if (fceu_bwrite_sub[pg]) return fceu_bwrite_sub[pg];
+	if (fceu_bwrite_pool_n >= FCEU_DISP_POOL) {
+		FCEU_PrintError("dispatch pool exhausted (write)");
+		return NULL;
+	}
+	t = fceu_bwrite_pool[fceu_bwrite_pool_n++];
+	for (i = 0; i < 256; i++) t[i] = fceu_bwrite_uni[pg];
+	fceu_bwrite_sub[pg] = t;
+	return t;
+}
+/* share identical subtables (PPU mirrors: 32 pages, one pattern) */
+static void aread_pool_intern(uint32_t pg) {
+	int i;
+	readfunc *t = fceu_aread_sub[pg];
+	if (!t || t != fceu_aread_pool[fceu_aread_pool_n - 1]) return;
+	for (i = 0; i < fceu_aread_pool_n - 1; i++)
+		if (!memcmp(fceu_aread_pool[i], t, sizeof fceu_aread_pool[0])) {
+			fceu_aread_sub[pg] = fceu_aread_pool[i];
+			fceu_aread_pool_n--;
+			return;
+		}
+}
+static void bwrite_pool_intern(uint32_t pg) {
+	int i;
+	writefunc *t = fceu_bwrite_sub[pg];
+	if (!t || t != fceu_bwrite_pool[fceu_bwrite_pool_n - 1]) return;
+	for (i = 0; i < fceu_bwrite_pool_n - 1; i++)
+		if (!memcmp(fceu_bwrite_pool[i], t, sizeof fceu_bwrite_pool[0])) {
+			fceu_bwrite_sub[pg] = fceu_bwrite_pool[i];
+			fceu_bwrite_pool_n--;
+			return;
+		}
+}
+void FCEU_SetReadAt(uint32_t a, readfunc fn) {
+	uint32_t pg = (a >> 8) & 0xFF;
+	readfunc *t = aread_page_materialize(pg);
+	if (t) { t[a & 0xFF] = fn; aread_pool_intern(pg); }
+}
+void FCEU_SetWriteAt(uint32_t a, writefunc fn) {
+	uint32_t pg = (a >> 8) & 0xFF;
+	writefunc *t = bwrite_page_materialize(pg);
+	if (t) { t[a & 0xFF] = fn; bwrite_pool_intern(pg); }
+}
 static readfunc *AReadG = NULL;
 static writefunc *BWriteG = NULL;
 static int RWWrap = 0;
