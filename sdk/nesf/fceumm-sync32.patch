diff --git a/src/fceu.h b/src/fceu.h
index 74c9026..8337744 100644
--- a/src/fceu.h
+++ b/src/fceu.h
@@ -56,8 +56,25 @@ extern uint8_t MMC5HackSPPage;
 
 extern uint8_t RAM[0x800];
 
-extern readfunc ARead[0x10000];
-extern writefunc BWrite[0x10000];
+/* sync32: two-level CPU bus dispatch (flat 512KB tables do not fit a
+   520KB-SRAM chip). Page-uniform fast path + shared byte subtables for
+   mixed pages. Behavior-identical to the flat arrays. */
+extern readfunc fceu_aread_uni[256];
+extern readfunc *fceu_aread_sub[256];
+extern writefunc fceu_bwrite_uni[256];
+extern writefunc *fceu_bwrite_sub[256];
+static INLINE readfunc FCEU_AReadAt(uint32_t A) {
+	uint32_t a = A & 0xFFFF;
+	readfunc *t = fceu_aread_sub[a >> 8];
+	return t ? t[a & 0xFF] : fceu_aread_uni[a >> 8];
+}
+static INLINE writefunc FCEU_BWriteAt(uint32_t A) {
+	uint32_t a = A & 0xFFFF;
+	writefunc *t = fceu_bwrite_sub[a >> 8];
+	return t ? t[a & 0xFF] : fceu_bwrite_uni[a >> 8];
+}
+void FCEU_SetReadAt(uint32_t a, readfunc fn);
+void FCEU_SetWriteAt(uint32_t a, writefunc fn);
 
 extern void (*GameInterface)(int h);
 extern void (*GameStateRestore)(int version);
